PORT=4000
# Opção 1 (recomendada): usar parâmetros separados (funciona bem com XAMPP padrão)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=geradorpro

# Opção 2: usar URL completa (se definir, ela tem prioridade)
# MYSQL_URL=mysql://root:senha@127.0.0.1:3306/geradorpro

JWT_SECRET=dev-secret
JWT_REFRESH_SECRET=dev-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
UPLOADS_DIR=uploads
GENERATED_DIR=generated
FFMPEG_PATH=ffmpeg

# Fallback apenas para facilitar login demo em ambiente local
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=admin123

# football-data.org (API v4)
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
